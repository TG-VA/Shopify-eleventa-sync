# ==============================================================================
# SHOPIFY-ELEVENTA SYNC — Variables de Entorno
# ==============================================================================
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.
# ==============================================================================

# --- Aplicación ---
# Entorno de ejecución: development | staging | production
APP_ENV=development
# Puerto donde escucha el servidor FastAPI
APP_PORT=8000
# Nivel de logging: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Clave secreta interna para firmar tokens y sesiones
APP_SECRET_KEY=cambiar-por-una-clave-segura-de-al-menos-32-caracteres

# --- Shopify ---
# Nombre de tu tienda (sin .myshopify.com)
SHOPIFY_STORE_NAME=mi-tienda
# Token de acceso de la aplicación personalizada (Admin API)
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Versión de la API de Shopify (formato: YYYY-MM)
SHOPIFY_API_VERSION=2024-10
# Secreto para verificar webhooks de Shopify (HMAC-SHA256)
SHOPIFY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ID de la ubicación principal en Shopify (para actualizar inventario)
SHOPIFY_LOCATION_ID=12345678901

# --- Eleventa (Firebird) ---
# Dirección IP o hostname del servidor Firebird donde corre Eleventa
ELEVENTA_DB_HOST=192.168.1.100
# Puerto del servidor Firebird (por defecto: 3050)
ELEVENTA_DB_PORT=3050
# Ruta completa a la base de datos Firebird en el servidor
ELEVENTA_DB_PATH=C:/Eleventa/Data/ELEVENTA.FDB
# Usuario de la base de datos Firebird
ELEVENTA_DB_USER=SYSDBA
# Contraseña del usuario de la base de datos Firebird
ELEVENTA_DB_PASSWORD=masterkey
# Codificación de caracteres (UTF8 recomendado)
ELEVENTA_DB_CHARSET=UTF8

# --- PostgreSQL (Middleware) ---
# URL de conexión completa a PostgreSQL
# Formato: postgresql://usuario:contraseña@host:puerto/base_de_datos
DATABASE_URL=postgresql://sync_user:contraseña_segura@localhost:5432/shopify_eleventa_sync

# --- Sincronización ---
# Intervalo de polling en segundos para revisar cambios en Eleventa
SYNC_POLL_INTERVAL_SECONDS=300
# Número máximo de reintentos para operaciones fallidas
SYNC_MAX_RETRIES=3
# Tiempo de espera entre reintentos en segundos (backoff exponencial)
SYNC_RETRY_DELAY_SECONDS=5
# Tamaño del lote para sincronización masiva
SYNC_BATCH_SIZE=50
# Umbral mínimo de similitud para auto-match por nombre (0.0 a 1.0)
SYNC_NAME_MATCH_THRESHOLD=0.85

# --- Notificaciones (Opcional) ---
# URL del webhook de Slack para alertas de errores
SLACK_WEBHOOK_URL=
# Correo electrónico para notificaciones críticas
ALERT_EMAIL=admin@mi-tienda.com
