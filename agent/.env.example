# ============================================
# Configuración del Agente de Sincronización
# ============================================

# URL de tu Middleware (FastAPI) en la nube o ngrok local
MIDDLEWARE_URL=https://tu-middleware.railway.app
# La misma API Key configurada en el servidor para autenticación
AGENT_API_KEY=test-agent-key-12345

# ============================================
# Base de Datos de Eleventa (Firebird)
# ============================================

# Ruta completa al archivo de base de datos de Eleventa (usualmente pdv.fdb)
# Usa barras dobles invertidas \\ o barras normales /
ELEVENTA_DB_PATH=C:/Program Files/Eleventa/pdv.fdb
# Credenciales por defecto de Firebird (Eleventa las usa así)
ELEVENTA_DB_USER=SYSDBA
ELEVENTA_DB_PASS=masterkey

# ============================================
# Configuración del Ciclo (Workers)
# ============================================

# Cada cuántos segundos el agente preguntará al servidor por nuevas ventas (bajada)
SYNC_DOWN_INTERVAL_SECONDS=10
# Cada cuántos segundos el agente escaneará Eleventa buscando ventas (subida)
SYNC_UP_INTERVAL_SECONDS=10
